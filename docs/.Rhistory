pivot_longer(cols = c(`Identity`, `Spiritual`, `Recreation`, `Aesthetic`, `Artistic`,`Educational`, `Bequest`),
names_to = "social",
values_to = "number")
f_v_sc <-
f_v_sc %>%
group_by(social, type) %>%
summarize(avg = mean(number, na.rm = TRUE),
se = sd(number, na.rm = TRUE))
ggplot(f_v_sc,
aes(y = reorder(social,avg),
x = avg,
fill = type))+
geom_col(position = position_dodge(width = 0.8))+
xlim(0,5.5) +
geom_errorbar(aes(xmin = avg - se, xmax = avg + se),
position = position_dodge(width = 0.8),
width = 0.2)+
labs(title = 'Mean Cultural Services By Farm Type',
y='Cultural Services',
x = 'Mean',
fill = 'Farm Type')+
theme_pomological_plain()+
scale_fill_manual(values = c("#edf7f7", "#9dc5c5", "#278787"))
